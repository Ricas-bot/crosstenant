{{!
    @template local_crosstenant/access_list

    Tabela de autorizações cross-tenant de um curso (secção 31 do prompt
    de implementação: "Authorized users - User, Source tenant, Role,
    Granted, Expires, Status, Actions").

    Context variables required for this template:
    * rows - array de autorizações já formatadas para apresentação
    * hasrows - bool
    * canmanage - bool, se o utilizador atual pode revogar

    Example context (json):
    {
        "hasrows": true,
        "canmanage": true,
        "rows": [
            {
                "userid": 23,
                "fullname": "João Silva",
                "sourcetenant": "Empresa A",
                "role": "Learner",
                "granted": "19/08/2026 10:00",
                "expires": "-",
                "status": "active",
                "statuslabel": "Ativa",
                "canrevoke": true,
                "reason": "Formação obrigatória"
            }
        ]
    }
}}
<div class="local-crosstenant-access-list" data-region="crosstenant-list">
    <h3>{{#str}}authorizedusers, local_crosstenant{{/str}}</h3>

    {{^hasrows}}
        <p class="text-muted">{{#str}}noauthorizations, local_crosstenant{{/str}}</p>
    {{/hasrows}}

    {{#hasrows}}
    <table class="generaltable" data-region="crosstenant-table">
        <thead>
            <tr>
                <th>{{#str}}user, local_crosstenant{{/str}}</th>
                <th>{{#str}}sourcetenant, local_crosstenant{{/str}}</th>
                <th>{{#str}}role, local_crosstenant{{/str}}</th>
                <th>{{#str}}granted, local_crosstenant{{/str}}</th>
                <th>{{#str}}expires, local_crosstenant{{/str}}</th>
                <th>{{#str}}status, local_crosstenant{{/str}}</th>
                {{#canmanage}}<th>{{#str}}actions, local_crosstenant{{/str}}</th>{{/canmanage}}
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr data-userid="{{userid}}">
                <td>{{fullname}}</td>
                <td>{{sourcetenant}}</td>
                <td>{{role}}</td>
                <td>{{granted}}</td>
                <td>{{expires}}</td>
                <td><span class="badge badge-pill badge-{{status}}">{{statuslabel}}</span></td>
                {{#canmanage}}
                <td>
                    {{#canrevoke}}
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            data-action="revoke" data-userid="{{userid}}" data-fullname="{{fullname}}"
                            data-sourcetenant="{{sourcetenant}}">
                        {{#str}}revoke, local_crosstenant{{/str}}
                    </button>
                    {{/canrevoke}}
                </td>
                {{/canmanage}}
            </tr>
            {{/rows}}
        </tbody>
    </table>
    {{/hasrows}}
</div>
